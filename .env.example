# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Frontend ---
# Origin the OAuth flows redirect back to.
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Local PostgreSQL container, read by docker-compose.yml.
POSTGRES_USER=skillchain
POSTGRES_PASSWORD=
POSTGRES_DB=skillchain
POSTGRES_PORT=5432

# Connection string the API uses. Locally it must match the container
# settings above; hosted environments point it at managed PostgreSQL.
DATABASE_URL=postgresql://skillchain:<POSTGRES_PASSWORD>@localhost:5432/skillchain

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider (xAI, OpenAI-compatible API) ---
XAI_API_KEY=
AI_MODEL=grok-3

# --- Attestation log ---
# Signed, append-only git log of issued reports. Disabled by default so
# local development and tests do not need a signing key.
ATTESTATION_ENABLED=false
ATTESTATION_REPO_PATH=./attestation-repo
ATTESTATION_SIGNING_KEY_PATH=
# Comma-separated push targets; mirroring to several independent hosts is
# what stops any single host from being able to erase the log.
ATTESTATION_REMOTES=

# --- Timestamping ---
# Anchors report hashes into Bitcoin via public OpenTimestamps calendars.
OTS_ENABLED=false
